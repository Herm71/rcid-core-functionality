<?xml version="1.0"?>
<ruleset name="RCID Core Functionality">
	<description>WordPress Coding Standards for the RCID core functionality plugin.</description>

	<!--
		Without this, `composer lint` exits 3 with "You must supply at least one
		file or directory to process" — the script passes no path of its own.
	-->
	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<!-- s: show sniff codes, p: show progress. -->
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="WordPress"/>

	<!--
		Everything in this plugin lives in the global namespace and is prefixed
		`rcid_`; the loader also defines BB_DIR.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="rcid"/>
				<element value="BB_DIR"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="rcid-core-functionality"/>
			</property>
		</properties>
	</rule>
</ruleset>
